{
  "name": "g7-stick-lab",
  "version": "2.0.2",
  "description": "GameSir G7 Pro 8K stick-only tuner — bit depth, curves, deadzone, polling",
  "main": "out/main/index.js",
  "author": "Kai",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.realkiyoshi.sticklabs",
    "productName": "Stick Labs",
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/node-hid/**/*",
      "node_modules/pkg-prebuilds/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Stick-Labs-setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Stick-Labs-portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Realkiyoshii",
        "repo": "stick-labs"
      }
    ]
  }
}
